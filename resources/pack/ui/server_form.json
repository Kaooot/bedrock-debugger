{
  "namespace": "server_form",
  "main_screen_content": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },
  "custom_form": {
    "type": "panel",
    "$visibility_key": "§a§n§r",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "custom_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 14px",
            10
          ],
          "size": [
            225,
            200
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.custom_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "none",
              "binding_name": "#title_text",
              "binding_name_override": "#title_text"
            },
            {
              "source_property_name": "((#title_text - $visibility_key) = #title_text)",
              "binding_type": "view",
              "target_property_name": "#visible"
            },
            {
              "source_property_name": "((#title_text - $visibility_key) = #title_text)",
              "binding_type": "view",
              "target_property_name": "#enabled"
            }
          ]
        }
      },
      {
        "custom_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 14px",
            10
          ],
          "size": [
            450,
            250
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.custom_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "none",
              "binding_name": "#title_text",
              "binding_name_override": "#title_text"
            },
            {
              "source_property_name": "(not ((#title_text - $visibility_key) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#visible"
            },
            {
              "source_property_name": "(not ((#title_text - $visibility_key) = #title_text))",
              "binding_type": "view",
              "target_property_name": "#enabled"
            }
          ]
        }
      }
    ]
  }
}